# Settings for Lumen on one server. install.sh copies this to .env and fills in the first block.
# Keep .env private: it holds secrets. After editing:  sudo docker compose up -d

# --- filled in by install.sh
DOMAIN="app.example.com"
ACME_EMAIL="you@example.com"
LUMEN_ADMIN_EMAILS="you@example.com"
LUMEN_SECRET_KEY=""

# --- the public demo at /demo (each visitor gets a private copy; set LUMEN_DEMO="" to turn it off)
LUMEN_DEMO="sandbox"
LUMEN_MAX_SANDBOXES="60"
LUMEN_SANDBOX_MAX_MB="24"

# --- email for sign-up confirmation, invitations and password resets (any SMTP provider)
# Port 587 or 2587/2525 use STARTTLS; 465 or 2465 use TLS from the start. Lightsail blocks only port 25;
# DigitalOcean blocks 25, 465 and 587 (use 2525 with Brevo, 2587 with Resend or Amazon SES).
LUMEN_SMTP_HOST=""
LUMEN_SMTP_PORT="587"
LUMEN_SMTP_USER=""
LUMEN_SMTP_PASSWORD=""
LUMEN_EMAIL_FROM="Lumen <no-reply@example.com>"

# --- company details shown on the website, legal pages and emails
LUMEN_COMPANY_NAME=""
LUMEN_COMPANY_ADDRESS=""
LUMEN_SUPPORT_EMAIL=""
LUMEN_SUPPORT_PHONE=""
LUMEN_GSTIN=""
LUMEN_GRIEVANCE_OFFICER=""
LUMEN_JURISDICTION=""
LUMEN_POLICIES_UPDATED=""
LUMEN_POLICIES_FINAL=""
LUMEN_BRAND="Lumen"

# --- payments: Razorpay test keys first, live keys after KYC (see deploy/aws/DEPLOY-AWS.md, step 7)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_TEAM_INR=""
RAZORPAY_PLAN_TEAM_USD=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TEAM_USD=""

# --- LLM jobs need a GPU server running Ollama on a private address; leave empty on this setup
LUMEN_PLATFORM_LLM_URL=""
LUMEN_PLATFORM_LLM_MODEL="llama3.1:8b"
