# Your domain, pointed at this server with a DNS "A" record
DOMAIN=lumen.example.com
# Email for the free Let's Encrypt HTTPS certificate
ACME_EMAIL=you@example.com
# Login for the web UI
LUMEN_USER=admin
# bcrypt hash of the password. Create it with:
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-strong-password'
# then paste it here and replace every $ with $$ (docker compose needs that)
LUMEN_PASSWORD_HASH=
