# Every Lumen Cloud setting, with what it does. On AWS you never edit this file:
#   - lines marked [stack]  are written by the CloudFormation stack into /opt/lumen/stack.env
#   - lines marked [secret] go into the Secrets Manager secret the stack creates (SettingsSecret output)
# To run Lumen Cloud on your own computer for testing:  set these in your shell, then  python -m lumen

LUMEN_MODE=cloud                              # turns on accounts, organisations, plans, billing, the website
LUMEN_DEMO=sandbox                            # public demo at /demo (each visitor a private copy)
# LUMEN_SANDBOX_MAX_MB=24  LUMEN_SANDBOX_MAX_AGE_MIN=480  LUMEN_DEMO_NEW_PER_HOUR=10   # demo copy size, lifetime, new per address
LUMEN_PUBLIC_URL=https://lumen.example.com    # [stack] from DomainName; used in emails and payment redirects
LUMEN_DATA_DIR=/data                          # control.db, tenants/<org>.db, demo copies
LUMEN_SECRET_KEY=                             # [secret] generated; peppers token hashes - never change it once live
LUMEN_ADMIN_EMAILS=you@example.com            # [stack] who sees /admin (comma-separated)

# Email (one of): Amazon SES with the server's role, any SMTP server, or none (files in data/outbox/)
LUMEN_SES_REGION=ap-south-1                   # [stack]
LUMEN_EMAIL_FROM=Lumen <no-reply@example.com> # [stack] the domain must be verified in SES
# LUMEN_SMTP_HOST=  LUMEN_SMTP_PORT=587  LUMEN_SMTP_USER=  LUMEN_SMTP_PASSWORD=

# The GPU server every organisation's LLM jobs run on (after approval)
LUMEN_PLATFORM_LLM_URL=http://10.0.1.20:11434 # [stack] the GPU server's private address
LUMEN_PLATFORM_LLM_MODEL=llama3.1:8b          # [stack]

# Razorpay (India; USD too if international payments are enabled on your Razorpay account)
RAZORPAY_KEY_ID=                              # [secret] Dashboard > Account & Settings > API keys
RAZORPAY_KEY_SECRET=                          # [secret]
RAZORPAY_WEBHOOK_SECRET=                      # [secret] the secret you type when adding the webhook
RAZORPAY_PLAN_TEAM_INR=                       # [secret] plan_... (Subscriptions > Plans: monthly, ₹6,999)
RAZORPAY_PLAN_TEAM_USD=                       # [secret] optional: a USD plan, used when Stripe is not set up

# Stripe (international cards; Stripe accounts for Indian businesses are invite-only)
STRIPE_SECRET_KEY=                            # [secret] sk_live_...
STRIPE_WEBHOOK_SECRET=                        # [secret] whsec_...
STRIPE_PRICE_TEAM_USD=                        # [secret] price_... (monthly, $79)

# Company details shown on the website, legal pages, invoices and emails
LUMEN_COMPANY_NAME=                           # [secret] legal name, e.g. "Rushi.AI Technologies Private Limited"
LUMEN_COMPANY_ADDRESS=                        # [secret] registered office
LUMEN_SUPPORT_EMAIL=                          # [secret]
LUMEN_SUPPORT_PHONE=                          # [secret]
LUMEN_GSTIN=                                  # [secret]
LUMEN_GRIEVANCE_OFFICER=                      # [secret] name and email (privacy law)
LUMEN_JURISDICTION=                           # [secret] e.g. "Ahmedabad, Gujarat"
LUMEN_POLICIES_UPDATED=                       # [secret] date shown on the policies
LUMEN_POLICIES_FINAL=                         # [secret] 1 after a lawyer reviewed them (removes the "Draft" note)
LUMEN_BRAND=Lumen                             # optional product name

# Plans: change prices and limits without code
# LUMEN_PLANS_FILE=/data/plans.json           # e.g. {"team": {"price": {"INR": 7999, "USD": 99}}}
